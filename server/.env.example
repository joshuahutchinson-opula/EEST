# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/eest

# Port the API listens on (Railway sets this automatically in production)
PORT=3001

# --- Microsoft Entra ID (Azure AD) sign-in ---
# Register an app at https://entra.microsoft.com (App registrations > New registration).
# Add a Web platform redirect URI matching MS_REDIRECT_URI below, then create a client secret
# under Certificates & secrets.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Use your tenant ID (or "organizations") to restrict sign-in to your own Entra directory;
# "common" also accepts personal Microsoft accounts, which then get filtered out by the
# ALLOWED_EMAIL_DOMAIN check below instead.
MS_TENANT_ID=common
# Must exactly match a redirect URI configured on the app registration.
MS_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# Only accounts whose email ends in @<this domain> are allowed to sign in.
ALLOWED_EMAIL_DOMAIN=e-techsystemsja.com

# The deployed frontend's origin — the OAuth callback redirects here once signed in.
APP_BASE_URL=http://localhost:5173

# Secret used to sign this app's own session tokens (not Microsoft's).
# Generate one with: openssl rand -base64 48
SESSION_JWT_SECRET=
