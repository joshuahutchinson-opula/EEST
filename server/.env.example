# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/eest

# Port the API listens on (Railway sets this automatically in production)
PORT=3001

# --- Microsoft Entra ID (Azure AD) sign-in ---
# Register an app at https://entra.microsoft.com (App registrations > New registration).
# Add a Web platform redirect URI matching MS_REDIRECT_URI below, then create a client secret
# under Certificates & secrets.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Use your tenant ID (or "organizations") to restrict sign-in to your own Entra directory;
# "common" also accepts personal Microsoft accounts, which then get filtered out by the
# ALLOWED_EMAIL_DOMAIN check below instead.
MS_TENANT_ID=common
# Must exactly match a redirect URI configured on the app registration.
MS_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# Only accounts whose email ends in @<this domain> are allowed to sign in.
ALLOWED_EMAIL_DOMAIN=e-techsystemsja.com

# The deployed frontend's origin — the OAuth callback redirects here once signed in.
APP_BASE_URL=http://localhost:5173

# Secret used to sign this app's own session tokens (not Microsoft's).
# Generate one with: openssl rand -base64 48
SESSION_JWT_SECRET=

# Directory for uploaded files (documents and photos). In production, point this at a
# persistent volume mount (e.g. /data/uploads) — the container filesystem is wiped on every
# redeploy. Defaults to the server's own "uploads" folder.
UPLOAD_DIR=

# Comma-separated emails that sign in with the restricted Tech role (everyone else is admin).
# Defaults to akeem, marvin, shanice and shavene @e-techsystemsja.com when unset.
TECH_EMAILS=

# Team members whose Outlook calendars the Calendar tab shows, and the email each task assignee
# name maps to: "Name=email, Name=email". Defaults to the app's TEAM names at
# firstname@ALLOWED_EMAIL_DOMAIN. The calendar and email alerts also need MS_TENANT_ID set to
# the real tenant id (not "common") and application permissions granted on the app registration.
TEAM_EMAILS=

# Email alerts (optional): the mailbox alerts are sent from, e.g. notifications@e-techsystemsja.com.
# Needs the Mail.Send application permission on the app registration. Off when blank.
MAIL_SENDER=

# CAMS (optional). Send to CAMS on the Installation page signs in to CAMS with a dedicated CAMS
# admin account; the button is hidden unless all three are set. CAMS_API_URL is the CAMS origin,
# e.g. https://e-tech-cams.up.railway.app (no trailing /api).
CAMS_API_URL=
CAMS_USERNAME=
CAMS_PASSWORD=
# Shared secret the CAMS server sends as X-Integration-Key on /api/integrations/cams/* (the CAMS
# mobile app API). Use a long random value and set the same one on CAMS. Off when blank.
CAMS_INTEGRATION_KEY=

# Error monitoring (optional). Leave blank to keep Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Demo login (optional, side door for showing the app outside the org) ---
# A single hardcoded account, separate from Microsoft SSO. Both vars must be set
# for POST /api/auth/demo/login to work; leave both blank to disable it.
# DEMO_PASSWORD_HASH is a bcrypt hash, never the plaintext password — generate one with:
#   node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" 'the-password'
DEMO_USERNAME=
DEMO_PASSWORD_HASH=
